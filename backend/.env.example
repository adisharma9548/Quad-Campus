# ── Server ─────────────────────────────────────────────
PORT=4000
HOST=127.0.0.1
DB_PATH=./data/quad.db
# Exact browser origin of your frontend (CORS). Use your real https:// domain in production.
FRONTEND_ORIGIN=http://localhost:5173
# Set to "production" when deployed. In production the server refuses to start without a strong AUTH_SECRET.
NODE_ENV=development

# ── Secrets (REQUIRED in production) ───────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-32-byte-random-hex-secret

# ── First administrator ────────────────────────────────
# Production: set a strong password (12+ chars). It creates ONLY this admin, with no demo data.
# Development: if empty, a random admin password is generated and printed once in the server log.
MOCK_ADMIN_EMAIL=admin.lead@btech.college.edu.in
MOCK_ADMIN_USERNAME=quad_admin
SEED_ADMIN_PASSWORD=

# ── Demo data (sales demos and development only) ───────
# Default: on in development, OFF in production. Adds ~25 fake students, posts, reels.
# SEED_DEMO_DATA=true
SEED_STUDENT_PASSWORD=

# ── White-label institution profile ────────────────────
# Presets: engineering (default) | university
INSTITUTION_PRESET=engineering
# Optional JSON file overriding any field (see institution.example.json)
# INSTITUTION_CONFIG_PATH=./institution.json
# Who may register: edu (college-style addresses) | domains (allowlist) | open (any valid email)
# EMAIL_POLICY=edu
# ALLOWED_EMAIL_DOMAINS=myschool.org,students.myschool.org
